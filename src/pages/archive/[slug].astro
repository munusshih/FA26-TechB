---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import ProjectMedia from "@/components/ProjectMedia.astro";
import SkipToMain from "@/components/SkipToMain.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
import {
  projectsWithMeta,
  projectsForYear,
  getProjectTitle,
  getProjectAuthor,
  buildParagraphs,
  fileEntriesForProject,
  buildLinkList,
  DESCRIPTION_FIELD,
  DESCRIPTION_FALLBACK_FIELD,
} from "@/lib/projects.js";

export function getStaticPaths() {
  return projectsWithMeta.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const title = getProjectTitle(project);
const author = getProjectAuthor(project);
const description =
  project[DESCRIPTION_FIELD] ?? project[DESCRIPTION_FALLBACK_FIELD] ?? "";
const descriptionParagraphs = buildParagraphs(description);
const mediaEntries = fileEntriesForProject(project);
const links = buildLinkList(project);
const creditsValue =
  project[
    "Credit (List out collaborators, tutorials, libraries, references, AI agents used)"
  ];
const creditLines =
  typeof creditsValue === "string"
    ? creditsValue
        .split(/\r?\n/)
        .map((line) => line.trim())
        .filter(Boolean)
    : [];

const CREDIT_LINK_PATTERN =
  /(https?:\/\/[^\s,;，；]+[^\s,;，；.!?)]|(?:www\.)?[a-z0-9](?:[a-z0-9-]*\.)+(?:com|org|net|edu|gov|io|ai|app|site|design|studio|dev|co|click|xyz|space)(?:\/[^\s,;，；]*)?)/gi;

const linkifyCredit = (line) => {
  const parts = [];
  let cursor = 0;

  for (const match of line.matchAll(CREDIT_LINK_PATTERN)) {
    const index = match.index ?? 0;
    if (index > cursor) parts.push({ text: line.slice(cursor, index) });
    const text = match[0];
    parts.push({
      text,
      href: /^https?:\/\//i.test(text) ? text : `https://${text}`,
    });
    cursor = index + text.length;
  }

  if (cursor < line.length) parts.push({ text: line.slice(cursor) });
  return parts;
};

const credits = creditLines.map(linkifyCredit);

const primaryMediaEntry =
  mediaEntries.find((entry) => entry.type === "image") ??
  mediaEntries.find((entry) => entry.type === "video") ??
  mediaEntries.find((entry) => entry.type === "pdf") ??
  mediaEntries[0] ??
  null;

const additionalMediaEntries = primaryMediaEntry
  ? mediaEntries.filter((entry) => entry.key !== primaryMediaEntry.key)
  : mediaEntries;

const yearProjects = projectsForYear(project.year);
const currentProjectIndex = yearProjects.findIndex(
  (candidate) => candidate.slug === project.slug,
);
const nextProject =
  currentProjectIndex >= 0 && yearProjects.length > 1
    ? yearProjects[(currentProjectIndex + 1) % yearProjects.length]
    : null;
const nextProjectTitle = nextProject ? getProjectTitle(nextProject) : null;
const nextProjectAuthor = nextProject ? getProjectAuthor(nextProject) : null;
---

<Layout
  pageTitle={`${title} — Technology B`}
  pageDescription={`${title} by ${author}, a Technology B student project.`}
  showChat={false}
>
  <SkipToMain />
  <Header
    hero="none"
    title={title}
    contextLabel={`by ${author}`}
    returnHref="/archive/"
  />

  <main id="main-content" class="project-detail cutoff" tabindex="-1">

    {
      primaryMediaEntry && (
        <section
          class="featured-media"
          aria-label="Featured project media"
          data-gsap-reveal
        >
          <ProjectMedia entry={primaryMediaEntry} featured />
        </section>
      )
    }

    <section
      class="project-context"
      aria-label="Project information"
      data-gsap-reveal
    >
      {
        descriptionParagraphs.length > 0 && (
          <div class="project-description">
            <h2 class="heading-2">Project Description</h2>
            {descriptionParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )
      }

      {
        (credits.length > 0 || links.length > 0) && (
          <aside class="project-metadata">
            {credits.length > 0 && (
              <section>
                <h2 class="heading-3">Credits</h2>
                <ul>
                  {credits.map((creditParts) => (
                    <li>
                      {creditParts.map((part) =>
                        part.href ? (
                          <a
                            href={part.href}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {part.text}
                          </a>
                        ) : (
                          part.text
                        ),
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )}
            {links.length > 0 && (
              <section>
                <h2 class="heading-3">Links</h2>
                <ul>
                  {links.map((link) => (
                    <li>
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.label} ↗
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </aside>
        )
      }
    </section>

    {
      additionalMediaEntries.length > 0 && (
        <section
          class="additional-media"
          aria-label="Additional project media"
          data-gsap-reveal
        >
          <div class="additional-media-list">
            {additionalMediaEntries.map((entry) => (
              <ProjectMedia entry={entry} />
            ))}
          </div>
        </section>
      )
    }

    {
      nextProject && nextProjectTitle && (
        <a
          href={`/archive/${nextProject.slug}`}
          class="next-project no-underline"
          aria-label={`Go to next project: ${nextProjectTitle}`}
          data-gsap-reveal
          data-next-project
        >
          <span>Next Project</span>
          <strong>{nextProjectTitle}</strong>
          {nextProjectAuthor && <span>by {nextProjectAuthor}</span>}
        </a>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .project-detail {
    box-sizing: border-box;
    padding-block: clamp(2rem, 4vw, 4rem) var(--space-section);
    padding-inline: var(--margin);
    width: 100%;
    max-width: none;
  }

  .project-detail > * {
    box-sizing: border-box;
    width: 100%;
    max-width: none;
  }

  .featured-media {
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .project-context {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    gap: var(--space-section);
    border-block: var(--rule);
    margin-block: clamp(4rem, 8vw, 8rem);
    padding-block: clamp(2rem, 4vw, 4rem);
  }

  .project-description {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .project-description h2,
  .project-description p {
    margin: 0;
  }

  .project-metadata {
    display: grid;
    align-content: start;
    gap: var(--space-card);
  }

  .project-metadata section {
    display: grid;
    gap: var(--space-2);
  }

  .project-metadata h2,
  .project-metadata ul {
    margin: 0;
  }

  .project-metadata ul {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .additional-media {
    display: grid;
    gap: var(--space-card);
    margin-block: clamp(4rem, 8vw, 8rem);
  }

  .additional-media-list {
    display: grid;
    gap: var(--space-section);
  }

  .next-project {
    display: grid;
    justify-items: end;
    gap: var(--space-1);
    margin-top: var(--space-section);
    padding-block: var(--space-card);
    text-align: right;
  }

  .next-project strong {
    max-width: 16ch;
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 0.9;
    font-family: var(--font-display);
  }

  @media (max-width: 760px) {
    .project-context {
      grid-template-columns: 1fr;
    }

    .project-context {
      gap: var(--space-card);
    }
  }
</style>

<script src="../../scripts/entrance-animations.js"></script>
<script>
  import { gsap } from "gsap";

  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  document.querySelectorAll("[data-next-project]").forEach((link) => {
    if (link.dataset.hoverReady === "true") return;
    link.dataset.hoverReady = "true";

    const title = link.querySelector("strong");
    const animate = (active) => {
      gsap.to(link, {
        x: active ? -14 : 0,
        duration: reducedMotion ? 0 : 0.38,
        ease: active ? "power3.out" : "power2.inOut",
        overwrite: "auto",
      });
      if (title) {
        gsap.to(title, {
          letterSpacing: active ? "0.025em" : "0em",
          duration: reducedMotion ? 0 : 0.38,
          ease: "power2.out",
          overwrite: "auto",
        });
      }
    };

    link.addEventListener("pointerenter", () => animate(true));
    link.addEventListener("pointerleave", () => animate(false));
    link.addEventListener("focus", () => animate(true));
    link.addEventListener("blur", () => animate(false));
  });
</script>
