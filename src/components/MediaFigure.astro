---
const {
  media,
  variant = "module",
  imageClass = "",
  loading = "lazy",
  sizes = "(min-width: 768px) 50vw, 100vw",
} = Astro.props;

const creatorCredit =
  media.creator && media.creator !== "Unknown author"
    ? ` · ${media.creator}`
    : "";
---

<figure class={`media-figure media-figure-${variant}`}>
  <div class="media-well">
    <img
      src={media.src}
      alt={media.alt}
      loading={loading}
      decoding="async"
      sizes={sizes}
      class={imageClass}
      style={`object-position: ${media.position ?? "center"}; object-fit: ${media.fit ?? "cover"}`}
    />
  </div>
  <figcaption>
    <a href={media.source} rel="license">
      <em>{media.title}</em>{creatorCredit}
    </a>
  </figcaption>
</figure>

<style>
  .media-figure {
    margin: 0;
    color: var(--ink);
  }

  .media-well {
    border: var(--rule);
    background: var(--paper-raised);
    overflow: hidden;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    border-bottom: 0;
    padding: var(--space-2) 0;
    font-size: 0.76rem;
    line-height: 1.25;
  }

  figcaption a {
    overflow-wrap: anywhere;
  }

  .media-figure-hero .media-well {
    height: clamp(24rem, 58vw, 52rem);
  }

  .media-figure-hero figcaption {
    padding-inline: 0;
  }

  .media-figure-module {
    margin-bottom: var(--space-card);
  }

  .media-figure-module .media-well,
  .media-figure-project .media-well {
    border: 0;
    aspect-ratio: 4 / 3;
  }

  .media-figure-project {
    margin-bottom: var(--space-card);
  }

  .image-filter-dither {
    filter: url("#single-color-dither");
  }

  @media (max-width: 640px) {
    .media-figure-hero .media-well {
      aspect-ratio: 4 / 3;
      height: auto;
    }
  }
</style>
