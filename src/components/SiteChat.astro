<aside class="site-chat-panel" data-site-chat aria-label="Course chatbot">
  <div class="chat-body" data-chat-body>
    <div class="chat-log" data-chat-log aria-live="polite"></div>
    <form class="chat-form" data-chat-form>
      <input
        id="course-chat-input"
        name="message"
        data-chat-input
        autocomplete="off"
        aria-label="Message ELIZA"
        placeholder="Message Eliza…"
      />
      <button type="submit" aria-label="Send message">↑</button>
    </form>
    <button class="chat-clear" type="button" data-chat-clear
      >Clear conversation</button
    >
  </div>
</aside>

<script>
  import { getAssembledReply, loadElizaInEnglish } from "eliza-core";
  import elizaScript from "eliza-util/eliza.script?raw";
  import { of } from "rxjs";

  const STORAGE_KEY = "tech-b-eliza-history-v3";
  const initialMessages = [
    {
      role: "bot",
      text: "How do you do. Please tell me your problem.",
    },
  ];

  document.querySelectorAll("[data-site-chat]").forEach(async (panel) => {
    if (panel.dataset.initialized === "true") return;
    panel.dataset.initialized = "true";

    const log = panel.querySelector("[data-chat-log]");
    const form = panel.querySelector("[data-chat-form]");
    const input = panel.querySelector("[data-chat-input]");
    const clear = panel.querySelector("[data-chat-clear]");
    const windowElement = panel.closest("[data-eliza-window]");
    const windowStatus = windowElement?.querySelector(
      "[data-eliza-window-status]",
    );
    input.disabled = true;
    let eliza = await loadElizaInEnglish(of(elizaScript));
    input.disabled = false;
    let thinking = false;
    let showThinking = false;
    let responseToken = 0;

    const setState = (state) => {
      panel.dataset.chatState = state;
      if (windowElement) windowElement.dataset.chatState = state;
      if (windowStatus) {
        windowStatus.textContent =
          state === "thinking"
            ? "ELIZA is thinking…"
            : state === "speaking"
              ? "ELIZA is responding…"
              : "Classic 1966 chatbot";
      }
    };

    const readMessages = () => {
      try {
        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
        return Array.isArray(stored) && stored.length
          ? stored
          : initialMessages;
      } catch {
        return initialMessages;
      }
    };

    let messages = readMessages();

    messages
      .filter(({ role }) => role === "user")
      .forEach(({ text }) => eliza.processInput(text));

    const saveMessages = () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(messages.slice(-40)));
      } catch {
        // The chatbot still works when storage is unavailable.
      }
    };

    const render = () => {
      log.replaceChildren();
      messages.forEach(({ role, text }) => {
        const row = document.createElement("div");
        row.className = `chat-row chat-row-${role}`;
        if (role === "bot") {
          const avatar = document.createElement("span");
          avatar.className = "chat-avatar";
          avatar.setAttribute("aria-hidden", "true");
          row.appendChild(avatar);
        }
        const group = document.createElement("div");
        group.className = "chat-message-group";
        const sender = document.createElement("span");
        sender.className = "chat-sender";
        sender.textContent = role === "bot" ? "ELIZA" : "YOU";
        const message = document.createElement("p");
        message.className = `chat-message chat-message-${role}`;
        message.textContent = text;
        group.append(sender, message);
        row.appendChild(group);
        log.appendChild(row);
      });

      if (thinking && showThinking) {
        const row = document.createElement("div");
        row.className = "chat-row chat-row-bot chat-thinking-row";
        const avatar = document.createElement("span");
        avatar.className = "chat-avatar";
        avatar.setAttribute("aria-hidden", "true");
        const bubble = document.createElement("div");
        bubble.className = "chat-thinking";
        bubble.setAttribute("role", "status");
        bubble.textContent = "ELIZA is thinking…";
        row.append(avatar, bubble);
        log.appendChild(row);
      }

      log.scrollTop = log.scrollHeight;
    };

    const replyTo = (message) => {
      return getAssembledReply(
        eliza.processInput(message),
        "Please go on.",
      ).trim();
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = input.value.trim();
      if (!message || thinking) return;

      messages.push({ role: "user", text: message });
      input.value = "";
      saveMessages();
      thinking = true;
      showThinking = true;
      setState("thinking");
      input.disabled = true;
      form.dataset.thinking = "true";
      const token = ++responseToken;
      render();

      await new Promise((resolve) =>
        window.setTimeout(
          resolve,
          showThinking ? 650 + Math.random() * 1250 : 220 + Math.random() * 300,
        ),
      );
      if (token !== responseToken) return;

      messages.push({ role: "bot", text: replyTo(message) });
      thinking = false;
      showThinking = false;
      setState("speaking");
      input.disabled = false;
      delete form.dataset.thinking;
      saveMessages();
      render();
      window.setTimeout(() => {
        if (!thinking) setState("idle");
      }, 1200);
      input.focus();
    });

    clear.addEventListener("click", async () => {
      responseToken += 1;
      thinking = false;
      showThinking = false;
      setState("idle");
      input.disabled = false;
      delete form.dataset.thinking;
      messages = [...initialMessages];
      input.disabled = true;
      eliza = await loadElizaInEnglish(of(elizaScript));
      input.disabled = false;
      saveMessages();
      render();
      input.focus();
    });

    render();
    setState("idle");
  });
</script>

<style is:global>
  .site-chat-panel {
    --chat-width: clamp(21rem, 28vw, 28rem);
    display: grid;
    position: relative;
    grid-template-rows: 1fr;
    z-index: 20;
    margin: 0;
    border-top: 0;
    border-bottom: 0;
    border-left: 0;
    background: var(--paper);
    width: 100%;
    height: 100%;
    color: var(--ink);
  }

  .chat-avatar {
    display: grid;
    position: relative;
    flex: 0 0 auto;
    place-items: center;
    border: var(--rule);
    border-radius: 0.2rem;
    background: var(--paper-raised);
    width: 1.85rem;
    height: 1.85rem;
    overflow: visible;
  }

  .chat-avatar::before {
    position: relative;
    z-index: 2;
    content: "E";
    font-weight: 600;
    font-size: 0.78rem;
    line-height: 1;
    font-family: var(--font-display);
  }

  .chat-avatar::after {
    position: absolute;
    opacity: 0;
    inset: -4px;
    border: var(--rule);
    border-radius: 0.2rem;
    content: "";
  }

  [data-chat-state="thinking"] .chat-avatar::after {
    opacity: 1;
    animation: avatar-think 900ms ease-in-out infinite alternate;
  }

  [data-chat-state="speaking"] .chat-avatar::before {
    animation: avatar-speak 420ms ease-in-out infinite alternate;
  }

  .chat-avatar-large {
    width: 2rem;
    height: 2rem;
  }

  .chat-header button,
  .chat-form button,
  .chat-clear {
    cursor: pointer;
    color: inherit;
  }

  .chat-header button {
    border: var(--rule);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    width: 1.65rem;
    height: 1.65rem;
    font-size: 0.72rem;
    line-height: 1;
  }

  .chat-header button:hover,
  .chat-header button:focus-visible {
    background: rgba(255, 255, 255, 0.14);
  }

  .chat-body {
    display: grid;
    grid-template-rows: 1fr auto auto;
    grid-template-columns: 1fr;
    min-height: 0;
  }

  .chat-log {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-right: 0;
    padding: 1rem 0.7rem;
    overflow-y: auto;
    scrollbar-color: var(--line-soft) transparent;
  }

  .chat-row {
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    width: 100%;
  }

  .chat-row-user {
    justify-content: flex-end;
  }

  .chat-message-group {
    display: grid;
    gap: 0.3rem;
    max-width: 82%;
  }

  .chat-row-user .chat-message-group {
    justify-items: end;
  }

  .chat-sender {
    padding: 0 0.38rem;
    color: var(--muted-ink);
    font-size: 0.58rem;
    line-height: 1;
    font-family: Arial, sans-serif;
    letter-spacing: 0.11em;
  }

  .chat-message {
    position: relative;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.42;
  }

  .chat-message-user {
    border: var(--rule);
    border-radius: 0.2rem;
    background: var(--paper-raised);
    padding: 0.72rem 0.9rem;
    color: var(--ink);
  }

  .chat-message-bot {
    border: var(--rule);
    border-radius: 0.2rem;
    background: transparent;
    padding: 0.72rem 0.9rem;
  }

  .chat-thinking {
    animation: thinking-pulse 1.1s ease-in-out infinite;
    border-left: var(--rule);
    padding: 0.4rem 0.7rem;
    color: var(--accent);
    font-size: 0.72rem;
    line-height: 1.2;
    font-family: ui-monospace, "SFMono-Regular", monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chat-form {
    display: grid;
    grid-template-columns: 1fr auto;
    margin: 0 0.7rem 0.55rem;
    border: var(--rule);
    border-radius: 0.2rem;
    background: transparent;
    padding: 0.28rem;
    overflow: hidden;
  }

  .chat-form input {
    outline: none;
    border: 0;
    background: transparent;
    padding: 0.65rem 0.6rem;
    min-width: 0;
  }

  .chat-form input:focus {
    box-shadow: none;
  }

  .chat-form:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--ink);
  }

  .chat-form button {
    align-self: center;
    border: 0;
    border-radius: 0.1rem;
    background: var(--ink);
    width: 2rem;
    height: 2rem;
    color: var(--paper);
    font-size: 1.15rem;
    line-height: 1;
  }

  .chat-form button:hover,
  .chat-form button:focus-visible,
  .chat-clear:hover,
  .chat-clear:focus-visible {
    opacity: 0.75;
  }

  .chat-form[data-thinking="true"] {
    opacity: 0.55;
  }

  .chat-clear {
    justify-self: center;
    margin-bottom: 0.75rem;
    border: 0;
    background: transparent;
    padding: 0.25rem 0.5rem;
    color: var(--muted-ink);
    font-size: 0.75rem;
  }

  @keyframes thinking-pulse {
    50% {
      opacity: 0.45;
    }
  }

  @keyframes avatar-think {
    to {
      transform: scale(1.12);
      opacity: 0.25;
    }
  }

  @keyframes avatar-speak {
    to {
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-avatar::after,
    [data-chat-state="speaking"] .chat-avatar::before,
    .chat-thinking {
      animation: none;
    }
  }
</style>
