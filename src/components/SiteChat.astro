    background: rgba(12, 9, 8, 0.96);
    width: var(--chat-width);
    height: 100svh;
    color: #fff;
  }

  .chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding: 1rem 1.1rem;
    line-height: 1;
  }

  .chat-identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

