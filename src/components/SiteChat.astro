    height: 2rem;
    line-height: 1;
  }

  .chat-header button:hover,
  .chat-header button:focus-visible {
    background: rgba(255, 255, 255, 0.14);
  }

  .chat-body {
    display: grid;
    grid-template-rows: 1fr auto auto;
    grid-template-columns: 1fr;
    min-height: 0;
  }

  .chat-log {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-right: 0;
