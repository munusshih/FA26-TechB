<aside class="site-chat-panel" data-site-chat aria-label="Course chatbot">
  <header class="chat-header">
    <div class="chat-identity">
      <span class="chat-avatar chat-avatar-large" aria-hidden="true"></span>
      <span>
        <strong>Eliza</strong>
        <small>Local course guide</small>
      </span>
    </div>
    <button
      type="button"
      data-chat-toggle
      aria-expanded="true"
      aria-label="Collapse chatbot">−</button
    >
  </header>

  <div class="chat-body" data-chat-body>
    <div class="chat-log" data-chat-log aria-live="polite"></div>
    <form class="chat-form" data-chat-form>
      <input
        id="course-chat-input"
        name="message"
        data-chat-input
        autocomplete="off"
        aria-label="Ask about the course"
        placeholder="Message Eliza…"
      />
      <button type="submit" aria-label="Send message">↑</button>
    </form>
    <button class="chat-clear" type="button" data-chat-clear
      >Clear conversation</button
    >
  </div>
</aside>

<script>
  import { ElizaBot } from "@agentic-profile/eliza";

  const STORAGE_KEY = "tech-b-eliza-history-v2";
  const initialMessages = [
    {
      role: "bot",
      text: "Hi, I’m Eliza. I know a little about DES 720B. You can ask me about the modules, grading, meeting time, policies, or resources.",
    },
  ];

  const siteAnswers = [
    {
      pattern: /^(hi|hello|hey|good morning|good afternoon)/,
      answer:
        "Hi! It’s nice to meet you. I only know a little, but I’m happy to try.",
    },
    {
      pattern: /thank|thanks/,
      answer: "You’re welcome. What else would you like to know?",
    },
    {
      pattern: /when|time|tuesday|meet/,
      answer: "Fall 2026. 2:00–4:50 PM, every Tuesday.",
    },
    {
      pattern: /where|room|steuben/,
      answer: "Steuben Hall, Room TK.",
    },
    {
      pattern: /instructor|teacher|faculty|office hour/,
      answer: "Instructor: TK. Office Hours: TK.",
    },
    {
      pattern: /grade|grading|percent|attendance/,
      answer:
        "Attendance & Participation and Projects 1–3 are each 25% of the final grade.",
    },
    {
      pattern: /module|project|black box|coded gaze|chain.of.thought/,
      answer:
        "The modules are Crack Inside the Black Box, The Coded Gaze, and Disrupting the Chain-of-Thought.",
    },
    {
      pattern: /policy|copy|borrow|license|integrity|ai tool/,
      answer:
        "Label borrowed code, understand what you use, respect licenses, and disclose AI-generated content.",
    },
    {
      pattern: /resource|lab|printing|cutting|shop|support/,
      answer:
        "Resources include School of Design Labs and Studios, printing and cutting equipment, the Tool Room, Academic Support, Accessibility, Wellbeing, and Public Safety.",
    },
    {
      pattern: /course|technology b|des 720b|what is this/,
      answer:
        "Students critically analyze and explore current and emerging technologies in design media.",
    },
  ];

  document.querySelectorAll("[data-site-chat]").forEach((panel) => {
    if (panel.dataset.initialized === "true") return;
    panel.dataset.initialized = "true";

    const log = panel.querySelector("[data-chat-log]");
    const form = panel.querySelector("[data-chat-form]");
    const input = panel.querySelector("[data-chat-input]");
    const toggle = panel.querySelector("[data-chat-toggle]");
    const clear = panel.querySelector("[data-chat-clear]");
    const eliza = new ElizaBot(false);
    let thinking = false;
    let responseToken = 0;

    const readMessages = () => {
      try {
        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
        return Array.isArray(stored) && stored.length
          ? stored
          : initialMessages;
      } catch {
        return initialMessages;
      }
    };

    let messages = readMessages();

    const saveMessages = () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(messages.slice(-40)));
      } catch {
        // The chatbot still works when storage is unavailable.
      }
    };

    const render = () => {
      log.replaceChildren();
      messages.forEach(({ role, text }) => {
        const row = document.createElement("div");
        row.className = `chat-row chat-row-${role}`;
        if (role === "bot") {
          const avatar = document.createElement("span");
          avatar.className = "chat-avatar";
          avatar.setAttribute("aria-hidden", "true");
          row.appendChild(avatar);
        }
        const message = document.createElement("p");
        message.className = `chat-message chat-message-${role}`;
        message.textContent = text;
        row.appendChild(message);
        log.appendChild(row);
      });

      if (thinking) {
        const row = document.createElement("div");
        row.className = "chat-row chat-row-bot chat-thinking-row";
        const avatar = document.createElement("span");
        avatar.className = "chat-avatar";
        avatar.setAttribute("aria-hidden", "true");
        const bubble = document.createElement("div");
        bubble.className = "chat-thinking";
        bubble.setAttribute("aria-label", "Eliza is thinking");
        bubble.innerHTML = "<i></i><i></i><i></i>";
        row.append(avatar, bubble);
        log.appendChild(row);
      }

      log.scrollTop = log.scrollHeight;
    };

    const replyTo = (message) => {
      const knownAnswer = siteAnswers.find(({ pattern }) =>
        pattern.test(message.toLowerCase()),
      );
      return knownAnswer
        ? `Here’s what I know: ${knownAnswer.answer}`
        : eliza.transform(message);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = input.value.trim();
      if (!message || thinking) return;

      messages.push({ role: "user", text: message });
      input.value = "";
      saveMessages();
      thinking = true;
      input.disabled = true;
      form.dataset.thinking = "true";
      const token = ++responseToken;
      render();

      await new Promise((resolve) =>
        window.setTimeout(resolve, 700 + Math.random() * 1100),
      );
      if (token !== responseToken) return;

      messages.push({ role: "bot", text: replyTo(message) });
      thinking = false;
      input.disabled = false;
      delete form.dataset.thinking;
      saveMessages();
      render();
      input.focus();
    });

    toggle.addEventListener("click", () => {
      const collapsed = panel.dataset.collapsed === "true";
      panel.dataset.collapsed = String(!collapsed);
      toggle.textContent = collapsed ? "−" : "+";
      toggle.setAttribute("aria-expanded", String(collapsed));
      toggle.setAttribute(
        "aria-label",
        collapsed ? "Collapse chatbot" : "Expand chatbot",
      );
    });

    clear.addEventListener("click", () => {
      responseToken += 1;
      thinking = false;
      input.disabled = false;
      delete form.dataset.thinking;
      messages = [...initialMessages];
      eliza.reset();
      saveMessages();
      render();
      input.focus();
    });

    render();
  });
</script>

<style>
  .site-chat-panel {
    --chat-width: clamp(21rem, 28vw, 28rem);
    display: grid;
    position: fixed;
    top: 0;
    right: 0;
    grid-template-rows: auto 1fr;
    z-index: 20;
    backdrop-filter: blur(18px);
    margin: 0;
    border-top: 0;
    border-bottom: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(12, 9, 8, 0.96);
    width: var(--chat-width);
    height: 100svh;
    color: #fff;
  }

  .chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding: 1rem 1.1rem;
    line-height: 1;
  }

  .chat-identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .chat-identity > span:last-child {
    display: grid;
    gap: 0.28rem;
  }

  .chat-identity strong {
    font-weight: 600;
    font-size: 1rem;
  }

  .chat-identity small {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.76rem;
  }

  .chat-avatar {
    display: block;
    position: relative;
    flex: 0 0 auto;
    box-shadow:
      0 0 1.5rem rgba(237, 153, 120, 0.25),
      inset 0 0 0.8rem rgba(255, 255, 255, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, #ffe3cf 0 12%, transparent 35%),
      radial-gradient(circle at 70% 65%, #d98568 0 12%, transparent 42%),
      conic-gradient(from 40deg, #5d2f37, #e6a27e, #8c647a, #5d2f37);
    width: 1.85rem;
    height: 1.85rem;
    overflow: hidden;
  }

  .chat-avatar::after {
    position: absolute;
    transform: rotate(15deg);
    opacity: 0.8;
    filter: blur(5px);
    animation: avatar-drift 6s ease-in-out infinite alternate;
    inset: -25%;
    background: linear-gradient(
      120deg,
      transparent 25%,
      #fff 48%,
      transparent 70%
    );
    content: "";
  }

  .chat-avatar-large {
    width: 2.55rem;
    height: 2.55rem;
  }

  .chat-header button,
  .chat-form button,
  .chat-clear {
    cursor: pointer;
    color: inherit;
  }

  .chat-header button {
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    width: 2rem;
    height: 2rem;
    line-height: 1;
  }

  .chat-header button:hover,
  .chat-header button:focus-visible {
    background: rgba(255, 255, 255, 0.14);
  }

  .chat-body {
    display: grid;
    grid-template-rows: 1fr auto auto;
    grid-template-columns: 1fr;
    min-height: 0;
  }

  .chat-log {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-right: 0;
    padding: 1.25rem 1rem;
    overflow-y: auto;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .chat-row {
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    width: 100%;
  }

  .chat-row-user {
    justify-content: flex-end;
  }

  .chat-message {
    margin: 0;
    max-width: 82%;
    font-size: 0.94rem;
    line-height: 1.42;
  }

  .chat-message-user {
    border-radius: 1.2rem 1.2rem 0.35rem 1.2rem;
    background: #f2d5c3;
    padding: 0.72rem 0.9rem;
    color: #211512;
  }

  .chat-message-bot {
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 1.2rem 1.2rem 1.2rem 0.35rem;
    background: rgba(255, 255, 255, 0.075);
    padding: 0.72rem 0.9rem;
  }

  .chat-thinking {
    display: flex;
    align-items: center;
    gap: 0.28rem;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 1rem 1rem 1rem 0.35rem;
    background: rgba(255, 255, 255, 0.075);
    padding: 0.75rem 0.9rem;
  }

  .chat-thinking i {
    animation: thinking-dot 1.1s ease-in-out infinite;
    border-radius: 50%;
    background: #e7aa8c;
    width: 0.32rem;
    height: 0.32rem;
  }

  .chat-thinking i:nth-child(2) {
    animation-delay: 140ms;
  }

  .chat-thinking i:nth-child(3) {
    animation-delay: 280ms;
  }

  .chat-form {
    display: grid;
    grid-template-columns: 1fr auto;
    margin: 0 1rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 1.6rem;
    background: rgba(255, 255, 255, 0.07);
    padding: 0.28rem;
    overflow: hidden;
  }

  .chat-form input {
    outline: none;
    border: 0;
    background: transparent;
    padding: 0.75rem 0.8rem;
    min-width: 0;
  }

  .chat-form input:focus {
    box-shadow: none;
  }

  .chat-form:focus-within {
    box-shadow: 0 0 0 3px rgba(217, 133, 104, 0.12);
    border-color: rgba(242, 213, 195, 0.75);
  }

  .chat-form button {
    align-self: center;
    border: 0;
    border-radius: 50%;
    background: #f2d5c3;
    width: 2.35rem;
    height: 2.35rem;
    color: #211512;
    font-size: 1.15rem;
    line-height: 1;
  }

  .chat-form button:hover,
  .chat-form button:focus-visible,
  .chat-clear:hover,
  .chat-clear:focus-visible {
    opacity: 0.75;
  }

  .chat-form[data-thinking="true"] {
    opacity: 0.55;
  }

  .chat-clear {
    justify-self: center;
    margin-bottom: 0.75rem;
    border: 0;
    background: transparent;
    padding: 0.25rem 0.5rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
  }

  .site-chat-panel[data-collapsed="true"] {
    top: auto;
    height: auto;
  }

  .site-chat-panel[data-collapsed="true"] .chat-body {
    display: none;
  }

  @media (min-width: 1025px) {
    :global(body) {
      padding-right: clamp(21rem, 28vw, 28rem);
    }
  }

  @media (max-width: 1024px) {
    .site-chat-panel {
      top: auto;
      bottom: 0;
      border-top: 1px solid #fff;
      border-left: 0;
      width: 100%;
      height: min(44svh, 30rem);
    }
  }

  @keyframes thinking-dot {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }

    30% {
      transform: translateY(-0.22rem);
      opacity: 1;
    }
  }

  @keyframes avatar-drift {
    to {
      transform: translate(12%, -8%) rotate(35deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-avatar::after,
    .chat-thinking i {
      animation: none;
    }
  }
</style>
