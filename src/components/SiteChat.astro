  }

  .chat-avatar {
    display: block;
    position: relative;
    flex: 0 0 auto;
    box-shadow:
      0 0 1.5rem rgba(237, 153, 120, 0.25),
      inset 0 0 0.8rem rgba(255, 255, 255, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
