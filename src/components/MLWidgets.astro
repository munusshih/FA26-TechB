<section
  class="ml-widgets"
  data-ml-widgets
  aria-label="Machine learning sketches"
>
  <header class="ml-header">
    <span class="ml-avatar" aria-hidden="true">ML</span>
    <span>
      <strong>Model Lab</strong>
      <small>Local browser sketches</small>
    </span>
  </header>

  <div class="ml-widget-list">
    <article class="ml-widget token-widget">
      <div class="ml-widget-heading">
        <span>Next-token sampler</span>
        <small>Markov model</small>
      </div>
      <p data-token-output>technology shapes how we see</p>
      <button type="button" data-token-generate>Sample sentence</button>
    </article>

    <article class="ml-widget knn-widget">
      <div class="ml-widget-heading">
        <span>Nearest neighbor</span>
        <small>k = 3</small>
      </div>
      <canvas
        data-knn-canvas
        aria-label="Interactive nearest-neighbor classifier"></canvas>
      <p class="knn-status" data-knn-status>
        Move across the field to classify.
      </p>
      <div class="knn-controls">
        <button type="button" data-knn-class="a" aria-pressed="true"
          >Class A</button
        >
        <button type="button" data-knn-class="b" aria-pressed="false"
          >Class B</button
        >
        <button type="button" data-knn-reset>Reset</button>
      </div>
    </article>
  </div>
</section>

<script>
  const corpus = `technology shapes how we see and how we make design asks who benefits from a system
  technology is never neutral design can expose the assumptions inside a system
  models learn patterns from data and data carries histories choices and omissions
  students build experiments that make computation visible strange and discussable`;

  document.querySelectorAll("[data-ml-widgets]").forEach((root) => {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const words = corpus.toLowerCase().match(/[a-z]+/g) || [];
    const transitions = new Map();
    words.slice(0, -1).forEach((word, index) => {
      const choices = transitions.get(word) || [];
      choices.push(words[index + 1]);
      transitions.set(word, choices);
    });
    const output = root.querySelector("[data-token-output]");
    root
      .querySelector("[data-token-generate]")
      ?.addEventListener("click", () => {
        let word = ["technology", "design", "models", "students"][
          Math.floor(Math.random() * 4)
        ];
        const sentence = [word];
        for (let index = 0; index < 8; index += 1) {
          const choices = transitions.get(word) || words;
          word = choices[Math.floor(Math.random() * choices.length)];
          sentence.push(word);
        }
        output.textContent = sentence.join(" ");
      });

    const canvas = root.querySelector("[data-knn-canvas]");
    const context = canvas?.getContext("2d");
    const status = root.querySelector("[data-knn-status]");
    if (!canvas || !context) return;
    let activeClass = "a";
    let pointer = null;
    let points = [];

    const resetPoints = () => {
      points = [
        { x: 0.2, y: 0.28, type: "a" },
        { x: 0.34, y: 0.58, type: "a" },
        { x: 0.25, y: 0.78, type: "a" },
        { x: 0.72, y: 0.22, type: "b" },
        { x: 0.66, y: 0.55, type: "b" },
        { x: 0.82, y: 0.72, type: "b" },
      ];
    };

    const nearest = (position) =>
      points
        .map((point) => ({
          ...point,
          distance: Math.hypot(point.x - position.x, point.y - position.y),
        }))
        .sort((a, b) => a.distance - b.distance)
        .slice(0, 3);

    const prediction = (position) => {
      const votes = nearest(position).filter(({ type }) => type === "a").length;
      return votes >= 2 ? "a" : "b";
    };

    const draw = () => {
      const { width, height } = canvas.getBoundingClientRect();
      context.clearRect(0, 0, width, height);
      context.fillStyle = "#0b0b0b";
      context.fillRect(0, 0, width, height);

      if (pointer) {
        const neighbors = nearest(pointer);
        const result = prediction(pointer);
        context.strokeStyle = result === "a" ? "#e7aa8c" : "#9886d8";
        context.globalAlpha = 0.34;
        neighbors.forEach((point) => {
          context.beginPath();
          context.moveTo(pointer.x * width, pointer.y * height);
          context.lineTo(point.x * width, point.y * height);
          context.stroke();
        });
        context.globalAlpha = 1;
        context.strokeStyle = result === "a" ? "#e7aa8c" : "#9886d8";
        context.lineWidth = 2;
        context.beginPath();
        context.arc(pointer.x * width, pointer.y * height, 7, 0, Math.PI * 2);
        context.stroke();
        status.textContent = `Prediction: class ${result.toUpperCase()}`;
      }

      points.forEach((point) => {
        context.fillStyle = point.type === "a" ? "#e7aa8c" : "#9886d8";
        context.beginPath();
        context.arc(point.x * width, point.y * height, 4, 0, Math.PI * 2);
        context.fill();
      });
    };

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(bounds.width * ratio));
      canvas.height = Math.max(1, Math.round(bounds.height * ratio));
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      draw();
    };

    canvas.addEventListener("pointermove", (event) => {
      const bounds = canvas.getBoundingClientRect();
      pointer = {
        x: (event.clientX - bounds.left) / bounds.width,
        y: (event.clientY - bounds.top) / bounds.height,
      };
      draw();
    });
    canvas.addEventListener("pointerleave", () => {
      pointer = null;
      status.textContent = "Move across the field to classify.";
      draw();
    });
    canvas.addEventListener("click", () => {
      if (!pointer) return;
      points.push({ ...pointer, type: activeClass });
      draw();
    });
    root.querySelectorAll("[data-knn-class]").forEach((button) => {
      button.addEventListener("click", () => {
        activeClass = button.dataset.knnClass;
        root.querySelectorAll("[data-knn-class]").forEach((choice) => {
          choice.setAttribute("aria-pressed", String(choice === button));
        });
      });
    });
    root.querySelector("[data-knn-reset]")?.addEventListener("click", () => {
      resetPoints();
      draw();
    });

    resetPoints();
    new ResizeObserver(resize).observe(canvas);
    resize();
  });
</script>

<style>
  .ml-widgets {
    height: 100%;
    overflow-y: auto;
  }

  .ml-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding: 0.72rem;
  }

  .ml-avatar {
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 50%;
    background: #181818;
    width: 2rem;
    height: 2rem;
    font-size: 0.55rem;
    font-family: Arial, sans-serif;
  }

  .ml-header > span:last-child {
    display: grid;
    gap: 0.2rem;
  }

  .ml-header strong {
    font-size: 0.82rem;
    line-height: 1;
  }

  .ml-header small {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.61rem;
    line-height: 1;
  }

  .ml-widget-list {
    display: grid;
    gap: 0.65rem;
    padding: 0.7rem;
  }

  .ml-widget {
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 0.7rem;
    background: rgba(255, 255, 255, 0.055);
    padding: 0.65rem;
  }

  .ml-widget-heading {
    display: flex;
    justify-content: space-between;
    gap: 0.4rem;
    font-size: 0.68rem;
  }

  .ml-widget-heading small {
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.56rem;
  }

  .token-widget p {
    margin: 0.75rem 0;
    min-height: 4.6em;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .ml-widget button {
    cursor: pointer;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.42rem 0.58rem;
    color: #fff;
    font-size: 0.6rem;
  }

  .ml-widget button:hover,
  .ml-widget button:focus-visible,
  .ml-widget button[aria-pressed="true"] {
    background: #fff;
    color: #111;
  }

  .knn-widget canvas {
    display: block;
    margin-block: 0.65rem 0.45rem;
    border-radius: 0.35rem;
    width: 100%;
    height: 8rem;
    touch-action: none;
  }

  .knn-status {
    margin: 0 0 0.55rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.6rem;
    line-height: 1.3;
  }

  .knn-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
</style>
