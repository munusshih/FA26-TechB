<div class="markov-sketch" data-markov-sketch>
  <canvas aria-label="Animated Markov chain visualization"></canvas>
</div>

<script>
  document.querySelectorAll("[data-markov-sketch]").forEach((root) => {
    const canvas = root.querySelector("canvas");
    const context = canvas?.getContext("2d");
    if (!canvas || !context) return;
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let width = 0;
    let height = 0;
    let visible = true;
    let frame = 0;
    let speed = 1;
    let hoveredNode = -1;
    let particles = [];
    let texturePixels = [];
    let pointerPosition = null;
    let nextMutation = performance.now() + 4000;
    let lastFrame = performance.now();
    let clock = 0;

    const nodePositions = [
      [0.49, 0.47],
      [0.26, 0.25],
      [0.65, 0.2],
      [0.78, 0.43],
      [0.62, 0.69],
      [0.3, 0.75],
      [0.16, 0.5],
      [0.82, 0.78],
    ];
    const targetPositions = nodePositions.map((position) => [...position]);

    const nodeStates = nodePositions.map((_, index) => ({
      life: 1,
      removing: false,
      phase: index * 1.7,
    }));

    const nodeLayout = () =>
      nodePositions.map(([x, y], index) => {
        const phase = nodeStates[index]?.phase || 0;
        return [
          x * width + Math.sin(clock * 0.38 + phase) * 12,
          y * height + Math.cos(clock * 0.31 + phase) * 9,
        ];
      });

    const transitions = [
      [0, 1],
      [0, 2],
      [0, 4],
      [0, 6],
      [1, 2],
      [1, 6],
      [1, 5],
      [2, 3],
      [2, 4],
      [3, 4],
      [3, 7],
      [4, 5],
      [4, 7],
      [5, 6],
      [5, 7],
    ];

    const pointOnLine = (from, to, progress) => {
      return [
        from[0] + (to[0] - from[0]) * progress,
        from[1] + (to[1] - from[1]) * progress,
      ];
    };

    const resetParticles = () => {
      particles = Array.from(
        { length: Math.max(18, Math.round(width / 38)) },
        (_, index) => ({
          edge: index % transitions.length,
          progress: Math.random(),
          velocity: 0.0018 + Math.random() * 0.0025,
          shape: index % 3,
          phase: Math.random() * Math.PI * 2,
          size: 0.75 + Math.random() * 0.8,
        }),
      );
    };

    const resetTexture = () => {
      let seed = 72026;
      const random = () => {
        seed = (seed * 1664525 + 1013904223) % 4294967296;
        return seed / 4294967296;
      };

      texturePixels = Array.from(
        { length: Math.max(180, Math.round(width / 3.5)) },
        (_, index) => ({
          x: Math.round((random() * width) / 4) * 4,
          y: Math.round((random() * height) / 4) * 4,
          size: 2 + Math.floor(random() * 3) * 2,
          alpha: 0.025 + random() * 0.1,
          phase: random() * Math.PI * 2,
          kind: index % 4,
        }),
      );
    };

    const relayoutOrganically = () => {
      targetPositions.forEach((position, index) => {
        if (index === 0) {
          position[0] = 0.49;
          position[1] = 0.47;
          return;
        }
        const angle = (index - 1) * 2.399963 + 0.25;
        const ring = index <= 5 ? 0.23 : 0.36;
        position[0] = 0.5 + Math.cos(angle) * ring * 1.18;
        position[1] = 0.5 + Math.sin(angle) * ring * 0.92;
      });
    };

    const connectRandomNodes = () => {
      if (nodePositions.length < 2) return;
      let from = Math.floor(Math.random() * nodePositions.length);
      let to = Math.floor(Math.random() * nodePositions.length);
      if (from === to) to = (to + 1) % nodePositions.length;
      const exists = transitions.some(
        ([a, b]) => (a === from && b === to) || (a === to && b === from),
      );
      if (exists) return;
      if (transitions.length >= 20) {
        transitions.splice(Math.floor(Math.random() * transitions.length), 1);
      }
      if (Math.random() < 0.5) [from, to] = [to, from];
      transitions.push([from, to]);
      resetParticles();
    };

    const addNode = (preferredSource = -1) => {
      if (nodePositions.length >= 12) return;

      const newIndex = nodePositions.length;
      const sourceIndices = [];
      if (preferredSource >= 0 && !sourceIndices.includes(preferredSource)) {
        sourceIndices.push(preferredSource);
      }
      while (sourceIndices.length < Math.min(3, nodePositions.length)) {
        const source = Math.floor(Math.random() * nodePositions.length);
        if (!sourceIndices.includes(source)) sourceIndices.push(source);
      }

      const origin = nodePositions[sourceIndices[0]] || [0.5, 0.5];
      nodePositions.push([...origin]);
      targetPositions.push([...origin]);
      nodeStates.push({
        life: reducedMotion ? 1 : 0,
        removing: false,
        phase: Math.random() * Math.PI * 2,
      });
      relayoutOrganically();
      sourceIndices.forEach((sourceIndex) =>
        transitions.push([sourceIndex, newIndex]),
      );

      hoveredNode = newIndex;
      resetParticles();
    };

    const addAutomaticNode = () => {
      addNode();
    };

    const removeAutomaticNode = () => {
      if (nodePositions.length <= 8) return;
      const state = nodeStates[nodeStates.length - 1];
      if (!state.removing) state.removing = true;
    };

    const mutateChain = () => {
      if (nodeStates.some(({ removing }) => removing)) return;
      if (nodePositions.length <= 8) {
        addAutomaticNode();
      } else if (Math.random() < 0.38) {
        connectRandomNodes();
      } else if (nodePositions.length < 12 && Math.random() < 0.62) {
        addAutomaticNode();
      } else {
        removeAutomaticNode();
      }
    };

    const updateNodes = (delta) => {
      nodeStates.forEach((state) => {
        const direction = state.removing ? -1 : 1;
        state.life = Math.min(
          1,
          Math.max(0, state.life + direction * delta * 1.25),
        );
      });
      nodePositions.forEach((position, index) => {
        const target = targetPositions[index];
        const easing = Math.min(1, delta * 2.8);
        position[0] += (target[0] - position[0]) * easing;
        position[1] += (target[1] - position[1]) * easing;
      });

      const lastState = nodeStates[nodeStates.length - 1];
      if (lastState?.removing && lastState.life <= 0) {
        const removedIndex = nodePositions.length - 1;
        nodePositions.pop();
        targetPositions.pop();
        nodeStates.pop();
        for (let index = transitions.length - 1; index >= 0; index -= 1) {
          if (transitions[index].includes(removedIndex))
            transitions.splice(index, 1);
        }
        if (hoveredNode === removedIndex) hoveredNode = -1;
        relayoutOrganically();
        resetParticles();
      }
    };

    const smoothstep = (value) => value * value * (3 - 2 * value);

    const nodeScale = (state) => {
      if (state.removing) return smoothstep(state.life);
      const inverse = state.life - 1;
      return Math.max(
        0,
        1 + 1.7 * inverse * inverse * inverse + 0.7 * inverse * inverse,
      );
    };

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, bounds.width);
      height = Math.max(1, bounds.height);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      resetParticles();
      resetTexture();
      draw();
    };

    const drawArrow = (from, to) => {
      context.beginPath();
      context.moveTo(...from);
      context.lineTo(...to);
      context.stroke();

      const angle = Math.atan2(to[1] - from[1], to[0] - from[0]);
      const arrowSize = Math.max(8, width * 0.007);
      context.beginPath();
      context.moveTo(to[0], to[1]);
      context.lineTo(
        to[0] - Math.cos(angle - 0.45) * arrowSize,
        to[1] - Math.sin(angle - 0.45) * arrowSize,
      );
      context.moveTo(to[0], to[1]);
      context.lineTo(
        to[0] - Math.cos(angle + 0.45) * arrowSize,
        to[1] - Math.sin(angle + 0.45) * arrowSize,
      );
      context.stroke();
    };

    const drawTexture = () => {
      context.save();

      for (let y = 2; y < height; y += 9) {
        context.fillStyle = "rgba(255,255,255,.022)";
        context.fillRect(0, y, width, 1);
      }

      texturePixels.forEach((pixel) => {
        const x = Math.round(
          pixel.x + Math.sin(clock * 0.34 + pixel.phase) * 3,
        );
        const y = Math.round(
          pixel.y + Math.cos(clock * 0.22 + pixel.phase) * 2,
        );
        const pulse = 0.6 + Math.sin(clock * 1.3 + pixel.phase) * 0.4;
        let alpha = pixel.alpha * pulse;

        if (pointerPosition) {
          const distance = Math.hypot(
            pointerPosition[0] - x,
            pointerPosition[1] - y,
          );
          if (distance < 170) alpha *= 1.8 - distance / 220;
        }

        context.fillStyle = `rgba(255,255,255,${alpha})`;
        if (pixel.kind === 0) {
          context.fillRect(x, y, pixel.size, pixel.size);
        } else if (pixel.kind === 1) {
          context.fillRect(x, y, pixel.size * 3, 1);
        } else if (pixel.kind === 2) {
          context.fillRect(x, y, 1, pixel.size * 2);
        } else {
          context.fillRect(x, y, pixel.size * 2, 2);
          context.fillRect(x + pixel.size, y - pixel.size, 2, pixel.size * 2);
        }
      });

      context.restore();
    };

    const draw = () => {
      context.clearRect(0, 0, width, height);
      drawTexture();
      const nodes = nodeLayout();
      const radius = Math.max(26, Math.min(width, height) * 0.1);

      transitions.forEach(([fromIndex, toIndex]) => {
        const fromCenter = nodes[fromIndex];
        const toCenter = nodes[toIndex];
        const length = Math.max(
          1,
          Math.hypot(toCenter[0] - fromCenter[0], toCenter[1] - fromCenter[1]),
        );
        const start = pointOnLine(fromCenter, toCenter, radius / length);
        const end = pointOnLine(fromCenter, toCenter, 1 - radius / length);
        const active = fromIndex === hoveredNode || toIndex === hoveredNode;
        const edgeLife = Math.min(
          nodeStates[fromIndex].life,
          nodeStates[toIndex].life,
        );
        context.strokeStyle = active
          ? `rgba(255,255,255,${edgeLife})`
          : `rgba(255,255,255,${edgeLife * 0.4})`;
        context.lineWidth = active ? 2 : 1;
        drawArrow(start, end);
      });

      particles.forEach((particle) => {
        particle.progress += particle.velocity * speed;
        particle.phase += 0.035 * speed;
        if (particle.progress >= 1) {
          particle.edge = Math.floor(Math.random() * transitions.length);
          particle.progress = 0;
        }
        const [fromIndex, toIndex] = transitions[particle.edge];
        const from = nodes[fromIndex];
        const to = nodes[toIndex];
        const [x, y] = pointOnLine(from, to, particle.progress);
        const angle = Math.atan2(to[1] - from[1], to[0] - from[0]);
        const particleSize = Math.max(3, width * 0.003) * particle.size;
        const pulse = 0.7 + Math.sin(particle.phase) * 0.3;
        const edgeLife = Math.min(
          nodeStates[fromIndex].life,
          nodeStates[toIndex].life,
        );

        context.save();
        context.translate(x, y);
        context.rotate(angle);
        context.fillStyle = "#fff";
        context.strokeStyle = "#fff";
        context.globalAlpha = (0.65 + pulse * 0.35) * edgeLife;

        if (particle.shape === 0) {
          context.lineWidth = Math.max(1.5, particleSize * 0.45);
          context.beginPath();
          context.moveTo(-particleSize * (1.5 + pulse), 0);
          context.lineTo(particleSize * (1.5 + pulse), 0);
          context.stroke();
        } else if (particle.shape === 1) {
          context.rotate(particle.phase * 0.25);
          context.fillRect(
            -particleSize * 0.65,
            -particleSize * 0.65,
            particleSize * 1.3,
            particleSize * 1.3,
          );
        } else {
          context.beginPath();
          context.moveTo(particleSize * 1.35, 0);
          context.lineTo(-particleSize, particleSize * 0.85);
          context.lineTo(-particleSize, -particleSize * 0.85);
          context.closePath();
          context.fill();
        }

        context.restore();
      });

      nodes.forEach(([x, y], index) => {
        const state = nodeStates[index];
        const scale = nodeScale(state);
        const alpha = smoothstep(state.life);
        const active = index === hoveredNode;
        const cellRadius = radius * (active ? 1.08 : 1);

        context.save();
        context.translate(x, y);
        context.scale(scale, scale);
        context.globalAlpha = alpha;

        context.fillStyle = active ? "#fff" : "#000";
        context.strokeStyle = "#fff";
        context.lineWidth = active ? 3 : 1.5;
        context.beginPath();
        context.arc(0, 0, cellRadius, 0, Math.PI * 2);
        context.fill();
        context.stroke();

        if (state.life < 0.98) {
          const burstProgress = state.removing ? 1 - state.life : state.life;
          const burstAlpha = Math.sin(burstProgress * Math.PI);
          const pixelSize = Math.max(3, radius * 0.1);
          context.fillStyle = "#fff";
          context.globalAlpha = burstAlpha;
          for (let pixel = 0; pixel < 8; pixel += 1) {
            const angle = (pixel / 8) * Math.PI * 2 + state.phase;
            const distance = cellRadius * (0.85 + burstProgress * 1.15);
            context.fillRect(
              Math.round(Math.cos(angle) * distance - pixelSize / 2),
              Math.round(Math.sin(angle) * distance - pixelSize / 2),
              pixelSize,
              pixelSize,
            );
          }
        }

        context.fillStyle = active ? "#000" : "#fff";
        context.font = `${Math.max(22, radius * 0.95)}px "Source Serif 4", Georgia, serif`;
        context.textAlign = "center";
        context.textBaseline = "middle";
        context.globalAlpha = alpha;
        context.fillText(String.fromCharCode(65 + index), 0, 0);
        context.restore();
      });
    };

    const animate = (time) => {
      const delta = Math.min(0.05, Math.max(0, (time - lastFrame) / 1000));
      lastFrame = time;
      clock += delta;
      if (visible) {
        updateNodes(delta);
        if (time >= nextMutation) {
          mutateChain();
          nextMutation = time + 3500 + Math.random() * 4000;
        }
        draw();
      }
      frame = window.requestAnimationFrame(animate);
    };

    canvas.addEventListener("pointermove", (event) => {
      const bounds = canvas.getBoundingClientRect();
      const pointer = [event.clientX - bounds.left, event.clientY - bounds.top];
      pointerPosition = pointer;
      const nodes = nodeLayout();
      const radius = Math.max(26, Math.min(width, height) * 0.1);
      hoveredNode = nodes.findIndex(
        ([x, y]) => Math.hypot(pointer[0] - x, pointer[1] - y) < radius * 1.8,
      );
      speed = hoveredNode >= 0 ? 2.6 : 1.15;
      draw();
    });

    canvas.addEventListener("pointerleave", () => {
      hoveredNode = -1;
      pointerPosition = null;
      speed = 1;
      draw();
    });

    canvas.addEventListener("click", (event) => {
      if (nodePositions.length >= 12) return;

      const bounds = canvas.getBoundingClientRect();
      const pointer = [event.clientX - bounds.left, event.clientY - bounds.top];
      const nodes = nodeLayout();
      const radius = Math.max(26, Math.min(width, height) * 0.1);
      const clickedNode = nodes.findIndex(
        ([x, y]) => Math.hypot(pointer[0] - x, pointer[1] - y) < radius * 1.25,
      );

      addNode(clickedNode);
      nextMutation = performance.now() + 5000;
      draw();
    });

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(root);

    resize();
    if (!reducedMotion) {
      frame = window.requestAnimationFrame(animate);
    }

    document.addEventListener(
      "astro:before-swap",
      () => window.cancelAnimationFrame(frame),
      { once: true },
    );
  });
</script>

<style>
  .markov-sketch {
    position: relative;
    flex: none;
    margin: clamp(-4.5rem, -5vw, -2.5rem) 0;
    width: min(100%, 1120px);
    height: clamp(400px, 38vw, 560px);
    overflow: hidden;
  }

  .markov-sketch canvas {
    display: block;
    cursor: crosshair;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  @media (max-width: 767px) {
    .markov-sketch {
      margin-block: -2.2rem;
      width: 112%;
      height: clamp(360px, 92vw, 480px);
    }
  }
</style>
