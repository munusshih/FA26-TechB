<div class="site-loader" data-site-loader role="status" aria-label="Loading Technology B">
  <div class="loader-instrument" aria-hidden="true">
    <svg viewBox="0 0 320 320">
      <g class="loader-ring loader-ring-outer">
        <circle cx="160" cy="160" r="132"></circle>
        <path d="M160 10v36M160 274v36M10 160h36M274 160h36"></path>
      </g>
      <g class="loader-ring loader-ring-inner">
        <circle cx="160" cy="160" r="82"></circle>
        <path d="M102 102l116 116M218 102 102 218"></path>
      </g>
      <g class="loader-rays">
        <path d="M160 160 18 84M160 160l284 0M160 160 18 236"></path>
        <path d="M160 160 302 84M160 160 18 160M160 160l142 76"></path>
      </g>
      <circle class="loader-core" cx="160" cy="160" r="8"></circle>
    </svg>
  </div>
  <div class="loader-copy">
    <span>Graduate Studio</span>
    <strong>Technology B</strong>
    <small>Arranging the faculties of intelligence…</small>
  </div>
  <button type="button" data-loader-skip>Enter site</button>
</div>

<script>
  const loader = document.querySelector("[data-site-loader]");
  if (loader) {
    const started = performance.now();
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    document.body.dataset.loading = "true";

    const dismiss = () => {
      if (loader.dataset.exiting === "true") return;
      loader.dataset.exiting = "true";
      delete document.body.dataset.loading;
      window.setTimeout(
        () => loader.remove(),
        reducedMotion ? 0 : 700,
      );
    };

    const finishAfterMinimum = () => {
      const elapsed = performance.now() - started;
      window.setTimeout(dismiss, reducedMotion ? 0 : Math.max(0, 1350 - elapsed));
    };

    if (document.readyState === "complete") finishAfterMinimum();
    else window.addEventListener("load", finishAfterMinimum, { once: true });

    loader
      .querySelector("[data-loader-skip]")
      ?.addEventListener("click", dismiss);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") dismiss();
    });
  }
</script>

<noscript><style>.site-loader { display: none !important; }</style></noscript>

