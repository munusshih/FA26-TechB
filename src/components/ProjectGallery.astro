---
import Accordion from "@/components/Accordion.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import SkipToMain from "@/components/SkipToMain.astro";
import Layout from "@/layouts/Layout.astro";
import {
  groupProjectsByModule,
  getProjectTitle,
  getProjectAuthor,
  getPrimaryMediaEntry,
  getDriveThumbnailUrl,
  getThumbnailPath,
} from "@/lib/projects.js";

const { projects, season, year } = Astro.props;
const groupedProjects = groupProjectsByModule(projects);
const totalProjects = projects.length;
---

<Layout
  pageTitle={`Technology B Project Archive — ${season} ${year}`}
  pageDescription={`Student work from Graduate Studio: Technology B, ${season} ${year}.`}
  showChat={false}
>
  <SkipToMain />
  <Header
    hero="students"
    returnHref="/"
    returnLabel="Back to Syllabus"
  />
  <main id="main-content" class="project-archive cutoff" tabindex="-1">
    <h2 class="heading-1 archive-title">Project Archive</h2>
    {
      totalProjects === 0 ? (
        <section class="empty-state card">
          <h3 class="heading-2">No projects have been published yet.</h3>
          <p>New submissions will appear here after the nightly refresh.</p>
        </section>
      ) : (
        groupedProjects.map(([moduleName, moduleProjects]) => (
          <Accordion title={moduleName} open noCutoff={true}>
            <div class="project-grid">
              {moduleProjects.map((project) => {
                const title = getProjectTitle(project);
                const author = getProjectAuthor(project);
                const primaryMedia = getPrimaryMediaEntry(project);
                const thumbnailPath = primaryMedia
                  ? getThumbnailPath(primaryMedia.value)
                  : null;
                const driveThumbnail =
                  primaryMedia?.type === "drive"
                    ? getDriveThumbnailUrl(primaryMedia.value)
                    : null;
                const rawCredits =
                  project[
                    "Credit (List out collaborators, tutorials, libraries, references, AI agents used)"
                  ];
                const credits =
                  typeof rawCredits === "string" ? rawCredits : "";
                return (
                  <article
                    class="card project-card"
                    data-project-card
                    data-credits={credits}
                  >
                    <a
                      href={`/archive/${project.slug}`}
                      class="project-media no-underline"
                    >
                      {primaryMedia ? (
                        primaryMedia.type === "video" ? (
                          thumbnailPath ? (
                            <img
                              src={thumbnailPath}
                              alt={primaryMedia.description || title}
                              loading="lazy"
                            />
                          ) : (
                            <video
                              src={primaryMedia.value}
                              muted
                              loop
                              playsInline
                              preload="metadata"
                            />
                          )
                        ) : primaryMedia.type === "drive" && driveThumbnail ? (
                          <img
                            src={driveThumbnail}
                            alt={primaryMedia.description || title}
                            loading="lazy"
                          />
                        ) : primaryMedia.type === "image" ||
                          primaryMedia.type === "local" ? (
                          <img
                            src={thumbnailPath || primaryMedia.value}
                            alt={primaryMedia.description || title}
                            loading="lazy"
                          />
                        ) : (
                          <span class="media-placeholder">
                            Media link available
                          </span>
                        )
                      ) : (
                        <span class="media-placeholder">No media provided</span>
                      )}
                    </a>
                    <div class="project-meta">
                      <h3 class="heading-3">
                        <a href={`/archive/${project.slug}`}>{title}</a>
                      </h3>
                      <p>{author}, {project.year}</p>
                    </div>
                  </article>
                );
              })}
            </div>
          </Accordion>
        ))
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .project-archive {
    box-sizing: border-box;
    padding-top: 0;
    padding-inline: var(--margin);
    padding-bottom: clamp(1.5rem, 3vw, 3rem);
    width: 100%;
    max-width: none;
  }
  .archive-title {
    margin: 0 auto var(--space-card);
    width: 100%;
    max-width: none;
    font-size: clamp(4rem, 10vw, 10rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
    text-align: center;
  }
  .project-archive :global(.accordion),
  .project-archive :global(.accordion-content) {
    box-sizing: border-box;
    width: 100%;
    max-width: none;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--space-card);
    row-gap: clamp(2.75rem, 5vw, 5rem);
    padding-block: var(--space-card);
    width: 100%;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border: 0 !important;
    background: transparent !important;
    padding: 0;
    width: 100%;
    overflow: visible;
  }
  .project-media {
    display: block;
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
  }
  .project-media img,
  .project-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-meta {
    display: grid;
    gap: 0.15rem;
    width: 100%;
  }
  .project-meta h3,
  .project-meta p {
    margin: 0;
  }
  .media-placeholder {
    display: grid;
    place-items: center;
    background: var(--paper);
    height: 100%;
  }
  .empty-state {
    margin-block: var(--space-section);
  }
  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script src="../scripts/entrance-animations.js"></script>
