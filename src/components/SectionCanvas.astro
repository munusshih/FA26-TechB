---
const { title = "Technology B" } = Astro.props;
---

<figure class="section-canvas" data-section-canvas data-seed={title} aria-hidden="true">
  <canvas></canvas>
  <span class="canvas-corner canvas-corner-nw"></span>
  <span class="canvas-corner canvas-corner-ne"></span>
  <span class="canvas-corner canvas-corner-sw"></span>
  <span class="canvas-corner canvas-corner-se"></span>
  <figcaption>
    <span>Computational plate</span>
    <span>{title}</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll("[data-section-canvas]").forEach((figure) => {
    if (figure.dataset.initialized === "true") return;
    figure.dataset.initialized = "true";
    const canvas = figure.querySelector("canvas");
    const context = canvas?.getContext("2d");
    if (!canvas || !context) return;

    const seedText = figure.dataset.seed || "Technology B";
    const seed = [...seedText].reduce(
      (value, character) => (value * 31 + character.charCodeAt(0)) >>> 0,
      2166136261,
    );
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    let width = 0;
    let height = 0;
    let visible = true;
    let frame = 0;

    const randomAt = (index) => {
      const value = Math.sin(seed * 0.00001 + index * 78.233) * 43758.5453;
      return value - Math.floor(value);
    };

    const colors = () => {
      const styles = getComputedStyle(document.documentElement);
      return {
        ink: styles.getPropertyValue("--ink").trim(),
        accent: styles.getPropertyValue("--accent").trim(),
        paper: styles.getPropertyValue("--paper-raised").trim(),
      };
    };

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, bounds.width);
      height = Math.max(1, bounds.height);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      draw(0);
    };

    const draw = (time) => {
      const palette = colors();
      const centerX = width * (0.38 + randomAt(1) * 0.24);
      const centerY = height * (0.38 + randomAt(2) * 0.24);
      const pulse = reducedMotion ? 0 : Math.sin(time * 0.00045 + seed) * 7;

      context.clearRect(0, 0, width, height);
      context.fillStyle = palette.paper;
      context.fillRect(0, 0, width, height);

      context.globalAlpha = 0.14;
      context.strokeStyle = palette.ink;
      context.lineWidth = 1;
      for (let x = 0; x <= width; x += 32) {
        context.beginPath();
        context.moveTo(x, 0);
        context.lineTo(x, height);
        context.stroke();
      }
      for (let y = 0; y <= height; y += 32) {
        context.beginPath();
        context.moveTo(0, y);
        context.lineTo(width, y);
        context.stroke();
      }

      context.globalAlpha = 0.82;
      context.strokeStyle = palette.ink;
      const rings = 5 + Math.floor(randomAt(3) * 4);
      for (let index = 0; index < rings; index += 1) {
        const radius =
          34 + index * Math.min(width, height) * 0.075 + pulse * (index % 2);
        context.beginPath();
        context.ellipse(
          centerX,
          centerY,
          radius * (1.1 + randomAt(index + 10) * 0.8),
          radius,
          randomAt(index + 20) * Math.PI,
          0,
          Math.PI * 2,
        );
        context.stroke();
      }

      const rayCount = 18 + Math.floor(randomAt(4) * 14);
      for (let index = 0; index < rayCount; index += 1) {
        const angle = (index / rayCount) * Math.PI * 2 + randomAt(5) * 0.3;
        const inner = 18 + (index % 3) * 10;
        const outer =
          Math.max(width, height) * (0.45 + randomAt(index + 40) * 0.45);
        context.globalAlpha = index % 4 === 0 ? 0.78 : 0.3;
        context.beginPath();
        context.moveTo(
          centerX + Math.cos(angle) * inner,
          centerY + Math.sin(angle) * inner,
        );
        context.lineTo(
          centerX + Math.cos(angle) * outer,
          centerY + Math.sin(angle) * outer,
        );
        context.stroke();
      }

      context.globalAlpha = 0.9;
      context.strokeStyle = palette.accent;
      context.lineWidth = 1.5;
      context.beginPath();
      for (let x = 0; x <= width; x += 4) {
        const y =
          centerY +
          Math.sin(x * 0.018 + seed + time * 0.00022) * height * 0.12 +
          Math.sin(x * 0.052 + seed * 0.1) * 8;
        if (x === 0) context.moveTo(x, y);
        else context.lineTo(x, y);
      }
      context.stroke();

      context.fillStyle = palette.ink;
      context.beginPath();
      context.arc(centerX, centerY, 5, 0, Math.PI * 2);
      context.fill();
    };

    const animate = (time) => {
      if (visible) draw(time);
      frame = window.requestAnimationFrame(animate);
    };

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting);
      if (visible) draw(performance.now());
    }).observe(figure);
    resize();
    if (!reducedMotion) frame = window.requestAnimationFrame(animate);

    window.addEventListener("pagehide", () => {
      if (frame) window.cancelAnimationFrame(frame);
    });
  });
</script>

<style>
  .section-canvas {
    position: relative;
    margin: 0 0 clamp(1rem, 2vw, 2rem);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    background: var(--paper-raised);
    width: 100%;
    min-height: clamp(20rem, 46vw, 40rem);
    overflow: hidden;
  }

  canvas {
    display: block;
    width: 100%;
    height: clamp(20rem, 46vw, 40rem);
  }

  figcaption {
    display: flex;
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--ink);
    background: color-mix(in srgb, var(--paper-raised) 88%, transparent);
    padding: 0.55rem 0.75rem;
    color: var(--ink);
    font-size: 0.6rem;
    font-family: ui-monospace, "SFMono-Regular", monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .canvas-corner {
    position: absolute;
    border-color: var(--ink);
    width: 2rem;
    height: 2rem;
  }

  .canvas-corner-nw {
    top: 1rem;
    left: 1rem;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .canvas-corner-ne {
    top: 1rem;
    right: 1rem;
    border-top: 1px solid;
    border-right: 1px solid;
  }

  .canvas-corner-sw {
    bottom: 3rem;
    left: 1rem;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }

  .canvas-corner-se {
    right: 1rem;
    bottom: 3rem;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }
</style>
