---
const {
  title = "Accordion Title",
  open = true,
  noCutoff = false,
} = Astro.props;
const isOpen =
  typeof open === "string" ? open.toLowerCase() !== "false" : Boolean(open);
const titleId = title.toLowerCase().replace(/\s+/g, "-");
const contentId = `${titleId}-content`;
const classes = `accordion ${noCutoff ? "" : "cutoff"}`.trim();
const sectionNumbers = {
  "Course Description": "01",
  "Community Agreement": "02",
  "Module 1: Crack Inside the Black Box": "03",
  "Module 2: The Coded Gaze": "04",
  "Module 3: Disrupting the Chain-of-Thought": "05",
  "Grading and Attendance": "06",
  "Open Source Policies": "07",
  "Pratt MFA Communications Design Departmental Resources": "08",
};
const isModule = title.startsWith("Module ");
const moduleNumber = title.match(/^Module\s+(\d+)/)?.[1];
const sectionNumber =
  sectionNumbers[title] ??
  (moduleNumber
    ? String(Number.parseInt(moduleNumber, 10) + 2).padStart(2, "0")
    : undefined);
const buttonClasses =
  `accordion-button ${isModule ? "texture-field" : ""}`.trim();
---

<section id={`${titleId}`} class={classes} data-open={isOpen}>
  <button
    class={buttonClasses}
    aria-expanded={isOpen ? "true" : "false"}
    aria-controls={contentId}
    type="button"
  >
    {
      sectionNumber && (
        <span class="accordion-number" aria-hidden="true">
          {sectionNumber}
        </span>
      )
    }
    <h2 class="heading-1">{title}</h2>
    <span class="accordion-state-label" aria-hidden="true">
      <span class="accordion-icon-expand">Unfold</span>
      <span class="accordion-icon-collapse">Fold</span>
    </span>
  </button>
  <div
    id={contentId}
    class="accordion-content relative"
    data-expanded={isOpen ? "true" : "false"}
    aria-hidden={isOpen ? "false" : "true"}
    inert={isOpen ? undefined : true}
  >
    <slot />
  </div>
</section>

<script>
  const syncContentHeight = (content) => {
    const isExpanded = content.dataset.expanded === "true";
    content.style.maxHeight = isExpanded ? `${content.scrollHeight}px` : "0px";
  };

  const setAccordionState = (accordion, expanded) => {
    const button = accordion.querySelector(".accordion-button");
    const content = accordion.querySelector(".accordion-content");
    if (!button || !content) return;

    const value = String(expanded);
    button.setAttribute("aria-expanded", value);
    content.dataset.expanded = value;
    content.setAttribute("aria-hidden", String(!expanded));
    content.toggleAttribute("inert", !expanded);
    accordion.setAttribute("data-open", value);
    syncContentHeight(content);
  };

  document.querySelectorAll(".accordion").forEach((accordion) => {
    const button = accordion.querySelector(".accordion-button");
    const content = accordion.querySelector(".accordion-content");
    if (!button || !content) return;

    setAccordionState(
      accordion,
      button.getAttribute("aria-expanded") === "true",
    );

    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";
      setAccordionState(accordion, !isExpanded);
    });

    const expandedObserver = new MutationObserver(() => {
      const isExpanded = content.dataset.expanded === "true";
      button.setAttribute("aria-expanded", String(isExpanded));
      accordion.setAttribute("data-open", String(isExpanded));
      syncContentHeight(content);
    });

    expandedObserver.observe(content, {
      attributes: true,
      attributeFilter: ["data-expanded"],
    });

    if ("ResizeObserver" in window) {
      const resizeObserver = new ResizeObserver(() => {
        if (content.dataset.expanded === "true") {
          syncContentHeight(content);
        }
      });

      resizeObserver.observe(content);
    }

    window.addEventListener("resize", () => {
      if (content.dataset.expanded === "true") {
        syncContentHeight(content);
      }
    });
  });
</script>
