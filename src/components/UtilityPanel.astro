---
import SiteChat from "./SiteChat.astro";
---

<aside
  class="eliza-window"
  data-eliza-window
  data-collapsed="true"
  aria-label="ELIZA chatbot window"
>
  <header class="eliza-window-bar" data-eliza-drag-handle>
    <button
      class="eliza-window-identity"
      type="button"
      data-eliza-toggle
      aria-expanded="false"
      aria-controls="eliza-window-content"
    >
      <span class="chat-avatar chat-avatar-large" aria-hidden="true"></span>
      <span>
        <strong>ELIZA</strong>
        <small data-eliza-window-status>Open conversation</small>
      </span>
    </button>
    <div class="eliza-window-actions">
      <button
        type="button"
        data-eliza-reset-position
        aria-label="Reset ELIZA window position"
        title="Reset window position">⌾</button
      >
      <button
        type="button"
        data-eliza-toggle
        aria-expanded="false"
        aria-controls="eliza-window-content"
        aria-label="Open ELIZA"
      >
        <span aria-hidden="true">↑</span>
      </button>
    </div>
  </header>
  <div id="eliza-window-content" class="eliza-window-content">
    <SiteChat />
  </div>
</aside>

<script>
  const STORAGE_KEY = "tech-b-eliza-window-v1";

  document.querySelectorAll("[data-eliza-window]").forEach((windowElement) => {
    if (windowElement.dataset.initialized === "true") return;
    windowElement.dataset.initialized = "true";

    const toggles = [...windowElement.querySelectorAll("[data-eliza-toggle]")];
    const dragHandle = windowElement.querySelector("[data-eliza-drag-handle]");
    const resetButton = windowElement.querySelector(
      "[data-eliza-reset-position]",
    );
    let drag = null;

    const save = () => {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            collapsed: windowElement.dataset.collapsed === "true",
            left: windowElement.dataset.dragged
              ? windowElement.style.left
              : null,
            top: windowElement.dataset.dragged
              ? windowElement.style.top
              : null,
          }),
        );
      } catch {
        // The window remains usable without persistence.
      }
    };

    const setCollapsed = (collapsed) => {
      windowElement.dataset.collapsed = String(collapsed);
      toggles.forEach((toggle) => {
        toggle.setAttribute("aria-expanded", String(!collapsed));
        if (toggle.matches("[aria-label]")) {
          toggle.setAttribute("aria-label", collapsed ? "Open ELIZA" : "Close ELIZA");
        }
      });
      const icon = toggles.at(-1)?.querySelector("span");
      if (icon) icon.textContent = collapsed ? "↑" : "×";
      if (!collapsed) {
        window.setTimeout(
          () => windowElement.querySelector("[data-chat-input]")?.focus(),
          180,
        );
      }
    };

    const resetPosition = () => {
      delete windowElement.dataset.dragged;
      windowElement.style.removeProperty("left");
      windowElement.style.removeProperty("top");
      windowElement.style.removeProperty("right");
      windowElement.style.removeProperty("bottom");
      windowElement.style.removeProperty("transform");
      save();
    };

    let state = { collapsed: true, left: null, top: null };
    try {
      state = { ...state, ...JSON.parse(localStorage.getItem(STORAGE_KEY)) };
    } catch {
      // Use the default position.
    }
    setCollapsed(Boolean(state.collapsed));
    if (state.left && state.top) {
      windowElement.dataset.dragged = "true";
      windowElement.style.left = state.left;
      windowElement.style.top = state.top;
      windowElement.style.right = "auto";
      windowElement.style.bottom = "auto";
      windowElement.style.transform = "none";
    }

    toggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        setCollapsed(windowElement.dataset.collapsed !== "true");
        save();
      });
    });
    resetButton?.addEventListener("click", resetPosition);

    dragHandle?.addEventListener("pointerdown", (event) => {
      if (event.target.closest("button") || event.button !== 0) return;
      const bounds = windowElement.getBoundingClientRect();
      drag = {
        pointerId: event.pointerId,
        offsetX: event.clientX - bounds.left,
        offsetY: event.clientY - bounds.top,
      };
      dragHandle.setPointerCapture(event.pointerId);
      windowElement.dataset.dragging = "true";
    });

    dragHandle?.addEventListener("pointermove", (event) => {
      if (!drag || event.pointerId !== drag.pointerId) return;
      const width = windowElement.offsetWidth;
      const height = windowElement.offsetHeight;
      const left = Math.min(
        window.innerWidth - width,
        Math.max(0, event.clientX - drag.offsetX),
      );
      const top = Math.min(
        window.innerHeight - height,
        Math.max(0, event.clientY - drag.offsetY),
      );
      windowElement.dataset.dragged = "true";
      windowElement.style.left = `${left}px`;
      windowElement.style.top = `${top}px`;
      windowElement.style.right = "auto";
      windowElement.style.bottom = "auto";
      windowElement.style.transform = "none";
    });

    const endDrag = (event) => {
      if (!drag || event.pointerId !== drag.pointerId) return;
      drag = null;
      delete windowElement.dataset.dragging;
      save();
    };

    dragHandle?.addEventListener("pointerup", endDrag);
    dragHandle?.addEventListener("pointercancel", endDrag);
  });
</script>

<style is:global>
  .eliza-window {
    display: grid;
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    grid-template-rows: auto minmax(0, 1fr);
    z-index: 50;
    margin: 0;
    border: var(--rule);
    border-radius: 0.3rem;
    background: var(--paper);
    width: min(27rem, calc(100vw - 2rem));
    height: min(68svh, 38rem);
    overflow: hidden;
    color: var(--ink);
    transition:
      width 180ms ease,
      height 180ms ease,
      border-color 300ms ease;
  }

  .eliza-window-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: grab;
    border-bottom: var(--rule);
    background: var(--paper) !important;
    padding: 0.4rem;
    touch-action: none;
    user-select: none;
  }

  .eliza-window[data-dragging="true"] .eliza-window-bar {
    cursor: grabbing;
  }

  .eliza-window-identity {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    cursor: pointer;
    border: 0;
    background: transparent;
    padding: 0.1rem;
    text-align: left;
  }

  .eliza-window-identity > span:last-child {
    display: grid;
    gap: 0.18rem;
  }

  .eliza-window-identity strong {
    font-size: 0.74rem;
    font-family: ui-monospace, "SFMono-Regular", monospace;
    letter-spacing: 0.08em;
  }

  .eliza-window-identity small {
    color: var(--muted-ink);
    font-size: 0.65rem;
  }

  .eliza-window-actions {
    display: flex;
    gap: 0.3rem;
  }

  .eliza-window-actions button {
    display: grid;
    place-items: center;
    cursor: pointer;
    border: var(--rule);
    border-radius: 0.15rem;
    background: transparent;
    width: 1.8rem;
    height: 1.8rem;
    color: inherit;
  }

  .eliza-window-actions button:hover,
  .eliza-window-actions button:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .eliza-window-content {
    min-height: 0;
    overflow: hidden;
  }

  .eliza-window[data-collapsed="true"] {
    display: block;
    width: 13.5rem;
    height: 3.25rem;
  }

  .eliza-window[data-collapsed="true"] .eliza-window-bar {
    border-bottom: 0;
  }

  .eliza-window[data-collapsed="true"] .eliza-window-content,
  .eliza-window[data-collapsed="true"] [data-eliza-reset-position] {
    display: none;
  }

  .eliza-window[data-chat-state="thinking"] {
    border-color: var(--ink);
  }

  @media (max-width: 640px) {
    .eliza-window {
      bottom: 0.5rem;
      width: calc(100vw - 1rem);
      height: min(72svh, 36rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eliza-window {
      transition: none;
    }
  }
</style>
