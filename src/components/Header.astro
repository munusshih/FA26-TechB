---
import AISketch from "../components/AISketch.astro";
import GanImage from "../components/GanImage.astro";

const {
  programUrl = "https://www.pratt.edu/design/graduate-communications-design/",
  programLabel = "Pratt Grad ComD",
  courseCode = "DES 720B",
} = Astro.props;
---

<header id="top" class="course-hero">
  <div class="course-meta-bar cutoff">
    <span>{courseCode}</span>
    <a href={programUrl}>{programLabel}</a>
    <span>Fall 2026</span>
  </div>

  <div class="course-title-wrap cutoff">
    <GanImage variant="title" />
    <h1 class="sr-only">Graduate Studio: Technology B</h1>
    <div class="title-studio" aria-hidden="true">Graduate Studio:</div>
    <AISketch />
    <div class="title-course" aria-hidden="true">Technology B</div>
  </div>
</header>
