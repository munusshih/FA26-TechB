---
const { item } = Astro.props;
const label = [item.title, item.author].filter(Boolean).join(", ");
---

<a
  class={`resource-card resource-card-${item.format ?? "square"}`}
  href={item.url}
  aria-label={label}
>
  <figure>
    <div class="resource-card-image">
      <img
        src={item.image.src}
        alt={item.image.alt}
        loading="lazy"
        decoding="async"
      />
    </div>
    <figcaption>
      <span class="resource-kind">{item.kind}</span>
      <h3 class="heading-3">{item.title}</h3>
      {item.author && <p>{item.author}</p>}
      {item.meta && <p>{item.meta}</p>}
    </figcaption>
  </figure>
</a>

<style>
  .resource-card {
    display: block;
    transition:
      background-color 180ms ease,
      color 180ms ease;
    border: var(--rule);
    background: color-mix(in srgb, var(--paper-raised) 84%, transparent);
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .resource-card-wide {
    grid-column: span 2;
  }

  figure {
    display: grid;
    grid-template-rows: auto 1fr;
    margin: 0;
    height: 100%;
  }

  .resource-card-image {
    border-bottom: var(--rule);
    background: var(--paper);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .resource-card-wide .resource-card-image {
    aspect-ratio: 2 / 1;
  }

  .resource-card-portrait .resource-card-image {
    aspect-ratio: 4 / 5;
  }

  img {
    display: block;
    filter: url("#single-color-dither");
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2);
    min-height: 8rem;
  }

  .resource-kind {
    font-size: 0.72rem;
    line-height: 1;
    font-family: var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: auto 0 0;
    font-size: clamp(1.35rem, 2vw, 2.35rem);
    text-decoration: underline;
    text-decoration-color: var(--line-soft);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.08em;
  }

  p {
    opacity: 0.78;
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.25;
  }

  .resource-card:hover,
  .resource-card:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .resource-card:hover img,
  .resource-card:focus-visible img {
    transform: scale(1.025);
  }

  .resource-card:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .resource-card-wide {
      grid-column: span 1;
    }

    .resource-card-wide .resource-card-image,
    .resource-card-portrait .resource-card-image {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resource-card,
    img {
      transition: none;
    }
  }
</style>
