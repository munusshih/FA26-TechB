---
const { item } = Astro.props;
const hasImage = Boolean(item.image);
const provenance = item.venue ?? item.provider;
const source = [provenance, item.origin].filter(Boolean).join(" · ");
---

<a
  class:list={["resource-card", { "resource-card-featured": hasImage }]}
  href={item.url}
>
  <figure>
    {
      hasImage && (
        <div class="resource-card-image">
          <img
            src={item.image.src}
            alt={item.image.alt}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
    <figcaption>
      <div class="resource-labels">
        <span class="resource-label">{item.kind}</span>
        {
          item.sourceType && (
            <span class="resource-label">{item.sourceType}</span>
          )
        }
        {item.status && <span class="resource-label">{item.status}</span>}
      </div>
      <h4 class="heading-3">{item.title}</h4>
      {item.author && <p class="resource-author">{item.author}</p>}
      {item.meta && <p class="resource-meta">{item.meta}</p>}
      {
        source && (
          <p class="resource-source">
            <span class="sr-only">Source: </span>
            {source}
          </p>
        )
      }
      <span class="resource-arrow" aria-hidden="true">↗</span>
    </figcaption>
  </figure>
</a>

<style>
  .resource-card {
    display: block;
    transition:
      background-color 180ms ease,
      color 180ms ease;
    background: color-mix(in srgb, var(--paper-raised) 84%, transparent);
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }

  figure {
    display: grid;
    grid-template-rows: auto 1fr;
    margin: 0;
    height: 100%;
  }

  .resource-card-image {
    background: var(--paper);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .resource-card-featured .resource-card-image {
    aspect-ratio: 3 / 2;
  }

  img {
    display: block;
    filter: url("#single-color-dither");
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-2) 2.8rem;
    min-height: 13rem;
  }

  .resource-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .resource-label {
    border-radius: 999px !important;
    background: var(--ink);
    padding: 0.3rem 0.55rem;
    color: var(--paper);
    font-size: 0.72rem;
    line-height: 1.2;
    font-family: var(--font-body);
  }

  h4 {
    margin: auto 0 0;
    font-size: clamp(1.3rem, 1.65vw, 2rem);
  }

  p {
    opacity: 0.78;
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.25;
  }

  .resource-source {
    font-style: italic;
    font-size: 0.78rem;
  }

  .resource-arrow {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    font-size: 1.25rem;
    line-height: 1;
  }

  .resource-card:hover,
  .resource-card:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .resource-card:hover .resource-label,
  .resource-card:focus-visible .resource-label {
    background: var(--paper);
    color: var(--ink);
  }

  .resource-card:hover img,
  .resource-card:focus-visible img {
    transform: scale(1.025);
  }

  .resource-card:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .resource-card,
    img {
      transition: none;
    }
  }
</style>
