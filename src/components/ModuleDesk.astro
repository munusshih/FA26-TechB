---
import TwoColumn from "./TwoColumn.astro";

const { readings = [], tools = [] } = Astro.props;
---

<div class="module-resources mt-4">
  <TwoColumn>
    <div class="weekly">
      <h3 class="heading-2">Suggested reading</h3>
      <ul>
        {
          readings.map((item) => (
            <li>
              <span>
                {item.url ? <a href={item.url}>{item.title}</a> : item.title}
                {item.note && (
                  <small class="mt-1 block text-sm leading-snug opacity-75">
                    {item.note}
                  </small>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="weekly">
      <h3 class="heading-2">Tools / materials</h3>
      <ul>
        {
          tools.map((item) => (
            <li>
              <span>
                {item.url ? <a href={item.url}>{item.title}</a> : item.title}
                {item.note && (
                  <small class="mt-1 block text-sm leading-snug opacity-75">
                    {item.note}
                  </small>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </TwoColumn>
</div>
